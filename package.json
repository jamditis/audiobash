{
  "name": "audiobash",
  "version": "3.2.0",
  "description": "Voice-controlled terminal for Claude Code",
  "main": "electron/main.cjs",
  "author": "Joe Amditis",
  "license": "MIT",
  "scripts": {
    "copy-vad-assets": "node scripts/copy-vad-assets.cjs",
    "dev": "npm run copy-vad-assets && vite",
    "build": "npm run copy-vad-assets && tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:py": "ruff check scripts build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "electron:dev": "npm run copy-vad-assets && concurrently \"vite --port 9527 --strictPort\" \"wait-on http://localhost:9527 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:mac:arm64": "npm run build && electron-builder --mac --arm64",
    "electron:build:mac:x64": "npm run build && electron-builder --mac --x64",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@google/generative-ai": "^0.21.0",
    "@remotion/install-whisper-cpp": "^4.0.405",
    "@ricky0123/vad-web": "^0.0.30",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.1.0",
    "openai": "^6.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.0.16",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.0.0",
    "electron": "^39.6.0",
    "electron-builder": "^26.7.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.6.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.38",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.0.0",
    "vitest": "^4.0.16",
    "wait-on": "^8.0.0"
  },
  "overrides": {
    "protobufjs": "^7.6.2",
    "ws": "^8.21.0"
  },
  "build": {
    "appId": "com.audiobash.app",
    "productName": "AudioBash",
    "npmRebuild": false,
    "afterPack": "./scripts/afterPack.cjs",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/node-pty/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "audiobash-logo.png",
        "to": "audiobash-logo.png"
      },
      {
        "from": "audiobash-logo.ico",
        "to": "audiobash-logo.ico"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "audiobash-logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "audiobash-logo.ico",
      "uninstallerIcon": "audiobash-logo.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AudioBash"
    },
    "afterSign": "./scripts/notarize.cjs",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "audiobash-logo.png",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist"
    },
    "dmg": {
      "sign": false,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "audiobash-logo.png",
      "category": "Development"
    }
  }
}
